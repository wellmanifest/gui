{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.com/schemas/gui-dsl/v1",
  "title": "Wellmanifest GUI DSL v1",
  "description": "Declarative description of an arbitrary product GUI conforming to wellmanifest/gui.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "surfaces"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schema": { "const": "wellmanifest.gui/dsl/v1" },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9.-]+)?$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "shape", "adopt"],
      "properties": {
        "home": { "enum": ["wellmanifest", "subactor", "semcod"] },
        "shape": { "enum": ["domain_pack", "runtime_service", "both"] },
        "adopt": { "const": "wellmanifest/gui" },
        "runtimeOwner": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "urlState": { "$ref": "#/$defs/urlState" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "testql": { "$ref": "#/$defs/testqlBinding" }
  },
  "$defs": {
    "cssSelector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "viewMode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "createLikeMode": {
      "type": "string",
      "enum": ["add", "create", "import", "register"]
    },
    "urlState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["params"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["replaceState", "pushState", "layered"],
          "default": "layered",
          "description": "layered = pushState on tab, replaceState on chrome and section view."
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tab"],
          "properties": {
            "tab": { "type": "string", "const": "tab" },
            "view": { "type": "string", "const": "view" },
            "item_view": { "type": "string", "const": "item_view" },
            "viewport": { "type": "string", "const": "viewport" },
            "chrome": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["lang", "currency", "theme", "organization", "last", "trail", "menu"]
              },
              "uniqueItems": true
            },
            "nested": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["project", "host", "org", "registry", "tag", "filter"]
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "toolbar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "titleSelector"],
      "properties": {
        "selector": { "$ref": "#/$defs/cssSelector" },
        "titleSelector": { "$ref": "#/$defs/cssSelector" },
        "subSelector": { "$ref": "#/$defs/cssSelector" },
        "icon": { "type": "string", "enum": ["svg-inline"] }
      }
    },
    "viewSwitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "modes", "createControl"],
      "properties": {
        "selector": { "$ref": "#/$defs/cssSelector" },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/viewMode" },
          "uniqueItems": true,
          "description": "Presentation modes only — create/import/add/register belong on createControl."
        },
        "createControl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["placement", "mode"],
          "properties": {
            "placement": { "const": "primary-button-left" },
            "toolbarSelector": { "$ref": "#/$defs/cssSelector" },
            "buttonSelector": { "$ref": "#/$defs/cssSelector" },
            "mode": { "$ref": "#/$defs/createLikeMode" }
          }
        }
      }
    },
    "infiniteScroll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["footerSelector"],
      "properties": {
        "footerSelector": { "$ref": "#/$defs/cssSelector" },
        "hook": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tagParam": { "type": "string", "const": "tag" },
        "filterParam": { "type": "string", "const": "filter" },
        "registryParam": { "type": "string", "const": "registry" }
      }
    },
    "systemChat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "persistence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "defaultUrl": { "type": "string", "format": "uri" },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary"],
          "properties": {
            "primary": {
              "type": "string",
              "enum": ["account-hosting", "server-config", "env"]
            },
            "injectionGlobal": {
              "type": "string",
              "pattern": "^__[A-Z0-9_]+__$"
            },
            "envVar": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "optionalBrowserOverride": {
              "type": "string",
              "enum": ["localStorage", "none"]
            }
          }
        },
        "gracefulFailure": { "const": true }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "tab"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "kind": {
          "enum": [
            "section",
            "system-chat",
            "account",
            "connector-registry",
            "hierarchy",
            "contextual-work",
            "group-overview"
          ]
        },
        "tab": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "toolbar": { "$ref": "#/$defs/toolbar" },
        "viewSwitch": { "$ref": "#/$defs/viewSwitch" },
        "infiniteScroll": { "$ref": "#/$defs/infiniteScroll" },
        "filters": { "$ref": "#/$defs/filters" },
        "systemChat": { "$ref": "#/$defs/systemChat" },
        "prependOnCreate": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "system-chat" } } },
          "then": { "required": ["systemChat"] }
        },
        {
          "if": {
            "properties": {
              "kind": { "enum": ["section", "connector-registry", "hierarchy", "contextual-work"] }
            }
          },
          "then": { "required": ["toolbar"] }
        }
      ]
    },
    "testqlBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "scenarioRefs"],
      "properties": {
        "driver": {
          "type": "string",
          "enum": ["playwright", "autogrammar", "product"]
        },
        "scenarioRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "assertSelectors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/cssSelector" }
        }
      }
    }
  }
}
