# TestQL GUI Standardization Assertion Suite
# Schema: subactor.testql/v1

SUITE "wellmanifest-gui-standardization" {
  TARGET "http://127.0.0.1:8781/?action=panel&currency=PLN"

  TEST "verify_header_toolbar_structure" {
    ASSERT_VISIBLE ".item-section-toolbar"
    ASSERT_VISIBLE ".panel-section-title"
    ASSERT_EXISTS ".panel-section-title svg"
  }

  TEST "verify_add_left_of_view_switch" {
    ASSERT_VISIBLE ".section-view-toolbar"
    ASSERT_VISIBLE ".section-add-button"
    ASSERT_VISIBLE ".item-view-switch"
  }

  TEST "verify_url_state_persistence" {
    CLICK ".section-add-button"
    ASSERT_URL_CONTAINS "view="
  }

  TEST "verify_infinite_scroll_footer" {
    ASSERT_VISIBLE ".infinite-scroll-footer"
  }
}
