# SCENARIO: GUI standardization (HOME wellmanifest/gui)
# ACTOR: human:founder
# ADOPT: wellmanifest/gui
# HOME: https://github.com/wellmanifest/gui
# TESTQL_VERSION: 2

SET gui_driver "playwright"

# Toolbar + identities-style Add left + view-switch modes only + URL sync
GUI_START "http://127.0.0.1:8781/?action=panel&tab=projects&view=cards"
WAIT 800

GUI_ASSERT_VISIBLE ".item-section-toolbar"
GUI_ASSERT_VISIBLE ".section-view-toolbar"
GUI_ASSERT_VISIBLE ".section-add-button"
GUI_ASSERT_VISIBLE ".view-switch"
GUI_ASSERT_VISIBLE ".infinite-scroll-footer"
GUI_ASSERT_VISIBLE ".footer"
GUI_ASSERT_VISIBLE "#global-viewport"
GUI_ASSERT_VISIBLE "#global-item-view"

GUI_EVAL "(() => { const bar=document.querySelector('.section-view-toolbar'); if(!bar) return 'NO_BAR'; const add=bar.querySelector('.section-add-button,[data-mode=add],[data-mode=import]'); const sw=bar.querySelector('.item-view-switch,.view-switch'); if(!add||!sw) return 'MISSING'; const createInSwitch=[...sw.querySelectorAll('button')].some(b=>{ const t=((b.getAttribute('data-mode')||'')+(b.title||'')+(b.textContent||'')).toLowerCase(); return /(^|[^a-z])(add|import|create|register)([^a-z]|$)/.test(t) && (b.classList.contains('item-view-button')); }); return createInSwitch ? 'CREATE_IN_SWITCH' : 'OK_ADD_LEFT'; })()"
GUI_ASSERT_TEXT "OK_ADD_LEFT"

GUI_CLICK ".section-add-button"
WAIT 400
GUI_EVAL "(() => { const v=new URL(location.href).searchParams.get('view')||'MISSING'; return v==='import'||v==='add' ? 'OK_VIEW' : v; })()"
GUI_ASSERT_TEXT "OK_VIEW"

GUI_EVAL "(() => new URL(location.href).searchParams.get('tab') || 'MISSING')()"
GUI_ASSERT_TEXT "projects"

# Viewport defaults write item_view, not view
GUI_NAVIGATE "http://127.0.0.1:8781/?action=panel&lang=pl&viewport=tablet"
WAIT 1200
GUI_EVAL "(() => { const q=new URLSearchParams(location.search); const v=document.querySelector('#global-viewport')?.value; const i=document.querySelector('#global-item-view')?.value; if(v!=='tablet') return 'viewport='+v; if(i!=='cards') return 'item_view='+i; if(q.get('item_view') && q.get('item_view')!=='cards') return 'url_item_view='+q.get('item_view'); if(q.get('view')==='cards'||q.get('view')==='list'||q.get('view')==='table') return 'PRESENTATION_IN_VIEW'; return 'TABLET_PANELS'; })()"
GUI_ASSERT_TEXT "TABLET_PANELS"

GUI_NAVIGATE "http://127.0.0.1:8781/?action=panel&lang=pl&viewport=pc"
WAIT 1200
GUI_EVAL "(() => { const v=document.querySelector('#global-viewport')?.value; const i=document.querySelector('#global-item-view')?.value; if(v!=='pc') return 'viewport='+v; if(i!=='table') return 'item_view='+i; return 'PC_TABLE'; })()"
GUI_ASSERT_TEXT "PC_TABLE"

# Compact phone chrome at 375px
GUI_NAVIGATE "http://127.0.0.1:8781/?action=panel&lang=pl&viewport=mobile"
WAIT 1200
GUI_ASSERT_VISIBLE ".mobile-menu-toggle"
GUI_EVAL "document.documentElement.style.maxWidth='375px'; document.body.style.maxWidth='375px'; const root=document.documentElement; const overflow=root.scrollWidth>root.clientWidth+1; const rail=document.querySelector('.workspace-rail'); const railOn=rail&&getComputedStyle(rail).display!=='none'; const ham=document.querySelector('.mobile-menu-toggle'); const hamOn=ham&&getComputedStyle(ham).display!=='none'; if(overflow) return 'horizontal_overflow'; if(railOn) return 'rail_visible'; if(!hamOn) return 'hamburger_hidden'; return 'PHONE_OK';"
GUI_ASSERT_TEXT "PHONE_OK"

# Support is not a rail leaf
GUI_EVAL "(() => { const rail=document.querySelector('.workspace-rail')||document.body; const text=(rail.textContent||'').toLowerCase(); const supportLeaf=rail.querySelector('[data-tab=support],button[data-tab=support],a[href*=\"tab=support\"]'); return supportLeaf || /\bwsparcie\b/.test(text) && rail.querySelector('[data-nav-id=support]') ? 'SUPPORT_LEAF' : 'SUPPORT_RETIRED'; })()"
GUI_ASSERT_TEXT "SUPPORT_RETIRED"

GUI_STOP
