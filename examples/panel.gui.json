{
  "schema": "wellmanifest.gui/dsl/v1",
  "$schema": "https://wellmanifest.com/schemas/gui-dsl/v1",
  "id": "subactor.www/panel",
  "version": "1.3.0",
  "title": "Subactor portal panel (ADOPT example)",
  "placement": {
    "home": "subactor",
    "shape": "runtime_service",
    "adopt": "wellmanifest/gui",
    "runtimeOwner": "subactor"
  },
  "urlState": {
    "strategy": "layered",
    "params": {
      "tab": "tab",
      "view": "view",
      "item_view": "item_view",
      "viewport": "viewport",
      "chrome": ["lang", "currency", "theme", "organization", "last", "trail", "menu"],
      "nested": ["project", "host", "org", "registry", "tag", "filter"]
    }
  },
  "surfaces": [
    {
      "id": "chat",
      "kind": "system-chat",
      "tab": "chat",
      "systemChat": {
        "id": "openwebui",
        "defaultUrl": "http://127.0.0.1:3004/",
        "persistence": {
          "primary": "account-hosting",
          "injectionGlobal": "__SUBACTOR_OPENWEBUI_URL__",
          "envVar": "SUBACTOR_OPENWEBUI_URL",
          "optionalBrowserOverride": "localStorage"
        },
        "gracefulFailure": true
      }
    },
    {
      "id": "configuration",
      "kind": "account",
      "tab": "configuration",
      "toolbar": {
        "selector": ".item-section-toolbar",
        "titleSelector": ".panel-section-title",
        "icon": "svg-inline"
      }
    },
    {
      "id": "api-tokens",
      "kind": "section",
      "tab": "api-tokens",
      "toolbar": {
        "selector": ".item-section-toolbar",
        "titleSelector": ".panel-section-title",
        "icon": "svg-inline"
      }
    },
    {
      "id": "hosts",
      "kind": "section",
      "tab": "hosts",
      "toolbar": {
        "selector": ".item-section-toolbar",
        "titleSelector": ".panel-section-title",
        "subSelector": ".section-sub",
        "icon": "svg-inline"
      },
      "viewSwitch": {
        "selector": ".item-view-switch",
        "modes": ["cards", "table", "list"],
        "createControl": {
          "placement": "primary-button-left",
          "toolbarSelector": ".section-view-toolbar",
          "buttonSelector": ".section-add-button",
          "mode": "add"
        }
      },
      "infiniteScroll": {
        "footerSelector": ".infinite-scroll-footer",
        "hook": "useInfiniteScroll"
      },
      "prependOnCreate": true
    },
    {
      "id": "group-infrastructure",
      "kind": "group-overview",
      "tab": "group-infrastructure"
    },
    {
      "id": "projects",
      "kind": "contextual-work",
      "tab": "projects",
      "toolbar": {
        "selector": ".item-section-toolbar",
        "titleSelector": ".panel-section-title",
        "icon": "svg-inline"
      },
      "viewSwitch": {
        "selector": ".item-view-switch",
        "modes": ["cards", "table", "list"],
        "createControl": {
          "placement": "primary-button-left",
          "toolbarSelector": ".section-view-toolbar",
          "buttonSelector": ".section-add-button",
          "mode": "import"
        }
      },
      "infiniteScroll": {
        "footerSelector": ".infinite-scroll-footer"
      },
      "prependOnCreate": true
    },
    {
      "id": "rest-api",
      "kind": "connector-registry",
      "tab": "rest-api",
      "toolbar": {
        "selector": ".item-section-toolbar",
        "titleSelector": ".panel-section-title",
        "icon": "svg-inline"
      },
      "viewSwitch": {
        "selector": ".item-view-switch",
        "modes": ["cards", "table"],
        "createControl": {
          "placement": "primary-button-left",
          "toolbarSelector": ".section-view-toolbar",
          "buttonSelector": ".section-add-button",
          "mode": "add"
        }
      },
      "filters": {
        "tagParam": "tag",
        "filterParam": "filter",
        "registryParam": "registry"
      },
      "prependOnCreate": true
    }
  ],
  "testql": {
    "driver": "playwright",
    "scenarioRefs": [
      "examples/testql/gui-standardization.testql",
      "subactor/testkit/tests/testql/gui-standardization.testql"
    ],
    "assertSelectors": {
      "toolbar": ".item-section-toolbar",
      "sectionViewToolbar": ".section-view-toolbar",
      "addButton": ".section-add-button",
      "viewSwitch": ".item-view-switch",
      "scrollFooter": ".infinite-scroll-footer",
      "sectionTitle": ".panel-section-title",
      "siteFooter": ".footer",
      "viewport": "#global-viewport",
      "itemView": "#global-item-view",
      "theme": "#nav-theme",
      "hamburger": ".mobile-menu-toggle",
      "groupOverview": "[data-group-overview]"
    }
  }
}
